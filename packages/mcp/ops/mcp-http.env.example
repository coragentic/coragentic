# Bind locally; a reverse proxy can be added later if desired.
CORAGENTIC_MCP_HOST=127.0.0.1
CORAGENTIC_MCP_PORT=3001
CORAGENTIC_API_URL=http://127.0.0.1:4000
# JSON object: each MCP client bearer token maps to exactly one upstream bearer token.
# Populate this file with real values only on the host, mode 0600. Do not commit it.
CORAGENTIC_MCP_TOKENS='{"replace-client-token":"replace-upstream-token"}'
