[Unit]
Description=Coragentic MCP Streamable HTTP service
After=network-online.target coragentic-api.service
Wants=network-online.target

[Service]
Type=simple
User=coragentic
Group=coragentic
WorkingDirectory=/opt/coragentic/packages/mcp
EnvironmentFile=/etc/coragentic/mcp-http.env
ExecStart=/opt/node-v26/node src/http.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/coragentic
# Resource ceilings: an independent review found the MCP transport had no
# app-level rate limiting (fixed in src/http-service.mjs) AND no OS-level
# resource ceiling, compounding an exhaustion risk. These bound worst-case
# impact from any traffic that slips past the application-level rate limiter.
MemoryMax=512M
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
