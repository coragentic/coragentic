[Unit]
Description=Create a consistent, root-only Coragentic SQLite recovery snapshot
After=coragentic-api.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/coragentic-state-backup
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/coragentic
