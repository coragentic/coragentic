{
  "name": "coragentic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api": "node server/index.mjs",
    "api:dev": "node --watch server/index.mjs",
    "worker": "node server/worker-entry.mjs",
    "test": "node --test --test-isolation=none --test-force-exit --test-timeout=60000 server/*.test.mjs && npm run test --prefix packages/core && npm test --prefix packages/mcp",
    "test:core": "node --test packages/core/test/runtime.test.mjs && node packages/core/examples/basic-agent.mjs",
    "pack:check": "npm run pack:check --prefix packages/mcp"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-3d": "^1.29.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1",
    "viem": "^2.56.9",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
